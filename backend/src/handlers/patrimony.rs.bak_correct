        Ok(None) => return HttpResponse::Unauthorized().json("Authentication required"),
        Err(e) => return e,
    };

    let patrimony_id = id.into_inner();
    
    let result = sqlx::query(
        "DELETE FROM patrimonies WHERE id = $1"
    )
    .bind(patrimony_id)
