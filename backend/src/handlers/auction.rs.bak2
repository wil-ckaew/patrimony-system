    .bind(auction_id)
    .bind(vehicle_id)
    .execute(pool.get_ref())
    .await
    .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;

    Ok(HttpResponse::Ok().json(serde_json::json!({
        "message": "Veículo removido do leilão com sucesso"
    })))
}

// ---------- VEÍCULOS DISPONÍVEIS ----------

pub async fn get_available_vehicles(
    pool: web::Data<PgPool>,
) -> Result<HttpResponse> {
    let vehicles = sqlx::query_as::<_, AvailableVehicle>(
        r#"
        SELECT 
            id,
            fleet_number,
            patrimony_name,
            patrimony_plate,
            chassi,
            renavam,
            model,
            year,
            department
        FROM fleet
        WHERE auctioned = FALSE AND read_only = FALSE
        ORDER BY fleet_number
        "#
    )
    .fetch_all(pool.get_ref())
    .await
    .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;

    Ok(HttpResponse::Ok().json(vehicles))
}

// ---------- FOTOS ----------

pub async fn upload_vehicle_photo(
    pool: web::Data<PgPool>,
    path: web::Path<(Uuid, String)>,
    _req: HttpRequest,
) -> Result<HttpResponse> {
    let (vehicle_id, photo_type) = path.into_inner();
    
    let valid_types = vec!["chassi", "plate", "front", "rear", "engine"];
    if !valid_types.contains(&photo_type.as_str()) {
        return Ok(HttpResponse::BadRequest().json(serde_json::json!({
            "error": "Tipo de foto inválido. Use: chassi, plate, front, rear, engine"
        })));
    }
    
    let photo_path = format!("/uploads/auctions/{}/{}.jpg", vehicle_id, photo_type);
    
    let column = format!("{}_photo_path", photo_type);
    let query = format!(
        "UPDATE auction_vehicles SET {} = $1 WHERE id = $2",
        column
    );
    
    sqlx::query(&query)
        .bind(&photo_path)
        .bind(vehicle_id)
        .execute(pool.get_ref())
        .await
        .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;
    
    Ok(HttpResponse::Ok().json(serde_json::json!({
        "message": "Foto enviada com sucesso",
        "vehicle_id": vehicle_id,
        "photo_type": photo_type,
        "photo_path": photo_path
    })))
}

pub async fn get_vehicle_photos(
    pool: web::Data<PgPool>,
    path: web::Path<Uuid>,
) -> Result<HttpResponse> {
    let vehicle_id = path.into_inner();
    
    let vehicle: AuctionVehicle = sqlx::query_as(
        "SELECT * FROM auction_vehicles WHERE id = $1"
    )
    .bind(vehicle_id)
    .fetch_one(pool.get_ref())
    .await
    .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;

    Ok(HttpResponse::Ok().json(serde_json::json!({
        "chassi": vehicle.chassi_photo_path,
        "plate": vehicle.plate_photo_path,
        "front": vehicle.front_photo_path,
        "rear": vehicle.rear_photo_path,
        "engine": vehicle.engine_photo_path
    })))
}

// ---------- PDF DOCUMENTOS ----------

pub async fn upload_auction_pdf(
    pool: web::Data<PgPool>,
    path: web::Path<Uuid>,
    dto: web::Json<AddPdfDto>,
) -> Result<HttpResponse> {
    let auction_id = path.into_inner();
    
    let valid_types = vec!["edital", "ata", "termo_entrega", "nota_arrematacao", 
                           "comprovante_pagamento", "publicacao_oficial", "laudo_avaliacao"];
    if !valid_types.contains(&dto.document_type.as_str()) {
        return Ok(HttpResponse::BadRequest().json(serde_json::json!({
            "error": "Tipo de documento inválido"
        })));
    }
    
    let file_path = format!("/documents/auctions/{}/{}.pdf", auction_id, dto.document_type);
    
    let pdf = sqlx::query_as::<_, AuctionPdf>(
        r#"
        INSERT INTO auction_pdfs (
            auction_id, document_type, file_path, file_name, uploaded_by
        )
        VALUES ($1, $2, $3, $4, 'Sistema')
        RETURNING *
        "#
    )
    .bind(auction_id)
    .bind(&dto.document_type)
    .bind(&file_path)
    .bind(&dto.file_name)
    .fetch_one(pool.get_ref())
    .await
    .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;

    Ok(HttpResponse::Created().json(pdf))
}

pub async fn get_auction_pdfs(
    pool: web::Data<PgPool>,
    path: web::Path<Uuid>,
) -> Result<HttpResponse> {
    let auction_id = path.into_inner();
    
    let pdfs = sqlx::query_as::<_, AuctionPdf>(
        "SELECT * FROM auction_pdfs WHERE auction_id = $1"
    )
    .bind(auction_id)
    .fetch_all(pool.get_ref())
    .await
    .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;

    Ok(HttpResponse::Ok().json(pdfs))
}

// ---------- BAIXA POR LEILÃO ----------

pub async fn finalize_auction(
    pool: web::Data<PgPool>,
    path: web::Path<Uuid>,
    dto: web::Json<FinalizeAuctionDto>,
) -> Result<HttpResponse> {
    let auction_id = path.into_inner();
    
    let vehicles: Vec<AuctionVehicle> = sqlx::query_as(
        "SELECT * FROM auction_vehicles WHERE auction_id = $1"
    )
    .bind(auction_id)
    .fetch_all(pool.get_ref())
    .await
    .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;
    
    if vehicles.is_empty() {
        return Ok(HttpResponse::BadRequest().json(serde_json::json!({
            "error": "Leilão não possui veículos para finalizar"
        })));
    }
    
    for vehicle in &vehicles {
        sqlx::query(
            r#"
            UPDATE fleet SET
                auctioned = TRUE,
                read_only = TRUE,
                auction_date = CURRENT_DATE
            WHERE id = $1
            "#
        )
        .bind(vehicle.vehicle_id)
        .execute(pool.get_ref())
        .await
        .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;
        
        let _ = sqlx::query(
            r#"
            INSERT INTO auction_logs (
                vehicle_id, auction_id, user_name, action, details
            )
            VALUES ($1, $2, 'Sistema', 'VEICULO_BAIXADO_POR_LEILAO', $3)
            "#
        )
        .bind(vehicle.vehicle_id)
        .bind(auction_id)
        .bind(serde_json::json!({
            "vehicle_id": vehicle.vehicle_id,
            "auction_id": auction_id,
            "sold_value": vehicle.sold_value,
            "buyer_name": vehicle.buyer_name
        }))
        .execute(pool.get_ref())
        .await;
    }

    let auction = sqlx::query_as::<_, Auction>(
        r#"
        UPDATE auctions SET status = $1
        WHERE id = $2
        RETURNING *
        "#
    )
    .bind(&dto.status)
    .bind(auction_id)
    .fetch_one(pool.get_ref())
    .await
    .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;

    Ok(HttpResponse::Ok().json(auction))
}

// ---------- HISTÓRICO ----------

pub async fn get_auction_history(
    pool: web::Data<PgPool>,
    path: web::Path<Uuid>,
) -> Result<HttpResponse> {
    let vehicle_id = path.into_inner();
    
    let history = sqlx::query_as::<_, AuctionHistory>(
        "SELECT * FROM auction_history WHERE auction_vehicle_id = $1 ORDER BY created_at DESC"
    )
    .bind(vehicle_id)
    .fetch_all(pool.get_ref())
    .await
    .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;

    Ok(HttpResponse::Ok().json(history))
}

pub async fn get_auction_logs(
    pool: web::Data<PgPool>,
    query: web::Query<serde_json::Value>,
) -> Result<HttpResponse> {
    let vehicle_id = query
        .get("vehicle_id")
        .and_then(|v| v.as_str())
        .and_then(|v| Uuid::parse_str(v).ok());

    let mut sql = String::from("SELECT * FROM auction_logs");
    let mut params: Vec<String> = vec![];

    if let Some(vehicle) = vehicle_id {
        sql.push_str(" WHERE vehicle_id = $1");
        params.push(vehicle.to_string());
    }

    sql.push_str(" ORDER BY created_at DESC");

    let logs = if let Some(vehicle) = vehicle_id {
        sqlx::query_as::<_, AuctionLog>(&sql)
            .bind(vehicle)
            .fetch_all(pool.get_ref())
            .await
    } else {
        sqlx::query_as::<_, AuctionLog>(&sql)
            .fetch_all(pool.get_ref())
            .await
    }
    .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;

    Ok(HttpResponse::Ok().json(logs))
}

// ---------- RELATÓRIOS ----------

pub async fn get_auctioned_vehicles_report(
    pool: web::Data<PgPool>,
    query: web::Query<SearchAuctionVehiclesDto>,
) -> Result<HttpResponse> {
    let search = query.search.clone().unwrap_or_default();
    let status = query.status.clone().unwrap_or_default();
    
    let mut sql = String::from(
        r#"
        SELECT * FROM vw_auction_full_report
        WHERE 1=1
        "#
    );
    
    let mut params: Vec<String> = Vec::new();
    let mut param_count = 1;
    
    if !search.is_empty() {
        sql.push_str(&format!(
            " AND (auction_number ILIKE ${} 
                OR edital_number ILIKE ${} 
                OR patrimony_plate ILIKE ${} 
                OR chassi ILIKE ${} 
                OR buyer_name ILIKE ${})",
            param_count, param_count, param_count, param_count, param_count
        ));
        params.push(format!("%{}%", search));
        param_count += 1;
    }
    
    if !status.is_empty() {
        sql.push_str(&format!(" AND auction_status = ${}", param_count));
        params.push(status);
    }
    
    sql.push_str(" ORDER BY auction_date DESC");
    
    let mut query_builder = sqlx::query_as::<_, AuctionFullReport>(&sql);
    for param in &params {
        query_builder = query_builder.bind(param);
    }
    
    let vehicles = query_builder
        .fetch_all(pool.get_ref())
        .await
        .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;

    Ok(HttpResponse::Ok().json(vehicles))
}

pub async fn get_auctioned_vehicles(
    pool: web::Data<PgPool>,
) -> Result<HttpResponse> {
    let vehicles = sqlx::query_as::<_, AuctionFullReport>(
        r#"
        SELECT * FROM vw_auction_full_report
        WHERE auction_status = 'BAIXA_CONCLUIDA'
        ORDER BY auction_date DESC
        "#
    )
    .fetch_all(pool.get_ref())
    .await
    .map_err(|e| actix_web::error::ErrorInternalServerError(e))?;

    Ok(HttpResponse::Ok().json(vehicles))
}
